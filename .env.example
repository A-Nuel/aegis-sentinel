# Public RPCs work out of the box; optional paid keys improve reliability
ETH_RPC_URL=https://eth.llamarpc.com
ARB_RPC_URL=https://arb1.arbitrum.io/rpc
BASE_RPC_URL=https://mainnet.base.org
OPT_RPC_URL=https://mainnet.optimism.io
POLYGON_RPC_URL=https://polygon-rpc.com

ALCHEMY_API_KEY=
INFURA_API_KEY=

# Orbio Build Week key (OpenAI-compatible)
# Dashboard told you: base URL = https://www.orbio.so/api/v1
ORBIO_API_KEY=
sk-orbio-...   # paste your real key only in local .env, never commit
ORBIO_BASE_URL=https://www.orbio.so/api/v1
ORBIO_MODEL=anthropic/claude-sonnet-4

# Legacy aliases (optional — same key works)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://www.orbio.so/api/v1

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CREDIT_LOW_THRESHOLD_USD=5
SCAN_INTERVAL_SECONDS=30
DEFAULT_CHAINS=ethereum,arbitrum,base
